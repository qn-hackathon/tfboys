# ======================================
# AI Service 测试环境配置
# ======================================

# ----- 基础服务配置 -----
# Redis 连接 URL
# Docker 环境: redis://redis:6379/0
# 本地开发: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Video Service URL
# Docker 环境: http://video-service:8003
# 本地开发: http://localhost:8003
VIDEO_SERVICE_URL=http://video-service:8003

# 本地存储目录
LOCAL_STORAGE_DIR=/tmp/tfboys

# ----- 七牛 AI Token API 配置 -----
# 统一使用七牛 AI Token API，支持:
# - 文本分析 (DeepSeek-V3)
# - 图像生成 (七牛文生图 API)
# - TTS (语音合成)
# 
# 获取方式: https://portal.qiniu.com/kodo/ak-sk
# 注意: 测试环境请使用真实的 API Key，否则 AI 功能无法正常工作
QINIU_API_KEY=your-qiniu-ai-token-api-key
