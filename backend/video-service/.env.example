# Redis配置
REDIS_URL=redis://localhost:6379/0

# OSS配置
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY=xxx
OSS_SECRET_KEY=xxx
OSS_BUCKET=tfboys

# 临时文件目录
TEMP_DIR=/tmp/video-service

# FFmpeg配置
FFMPEG_THREADS=4

# 字体路径
CHINESE_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# AI服务回调URL(可选)
AI_SERVICE_CALLBACK_URL=http://ai-service:8001/callbacks/video-completed
